{
  "name": "Student Support System (PHP + MariaDB)",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "web",
  "workspaceFolder": "/var/www/html",
  "forwardPorts": [80],
  "portsAttributes": {
    "80": { "label": "Web app", "onAutoForward": "openBrowser" }
  },
  "shutdownAction": "stopCompose"
}
