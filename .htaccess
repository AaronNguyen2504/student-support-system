# =============================================================================
# .htaccess - Cấu hình máy chủ Apache cho toàn hệ thống
# =============================================================================

# --- Bảng mã mặc định: bảo đảm tiếng Việt hiển thị đúng ---
AddDefaultCharset UTF-8

# --- Trang mặc định của mỗi thư mục ---
DirectoryIndex index.php index.html

# --- Không cho liệt kê nội dung thư mục khi thiếu tệp index ---
Options -Indexes

# --- Chặn truy cập trực tiếp vào tệp cấu hình, dữ liệu (.sql), tài liệu (.md) và nhật ký (.log) ---
<FilesMatch "^(config\.php|config\.local\.php|composer\.json|\.gitignore)$|\.(sql|md|log)$">
    Require all denied
</FilesMatch>

# --- Chặn truy cập thư mục thư viện và nhật ký ---
RedirectMatch 403 ^/(.*/)?(lib|logs)/

# --- Một vài phần đầu HTTP tăng cường an toàn ---
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # CSP: chỉ nạp tài nguyên cùng nguồn. Không cho script nội tuyến (JS nằm trong js/script.js).
    # setifempty: download.php tự đặt CSP chặt hơn cho tệp tải về thì giữ nguyên.
    Header setifempty Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# --- Trang lỗi thân thiện (tùy chọn) ---
ErrorDocument 403 "Ban khong co quyen truy cap tai nguyen nay."

# --- Nén văn bản trước khi gửi (HTML, CSS, JS) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# --- Cache tệp tĩnh. CSS/JS được gắn ?v=<mtime> (hàm asset()) nên cache lâu vẫn nhận bản mới ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
